{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Krio brand colour tokens — Bloomberg & Cobalt. Cool Archival Alabaster Canvas & Royal Blue.",
  "$version": "2.1.0",
  "$updated": "2026-10-03",
  "brivo": {
