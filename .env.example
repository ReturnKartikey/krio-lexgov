# ==============================================================================
# OpenGov Intelligence Explorer — Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="OpenGov Intelligence Explorer"
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=True

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=opengov_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:your_secure_postgres_password_here@localhost:5432/opengov_db
SYNC_DATABASE_URL=postgresql+psycopg://postgres:your_secure_postgres_password_here@localhost:5432/opengov_db

# Redis & Cache
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# Crawler & Public Registry Compliance
CRAWLER_USER_AGENT="OpenGov-Bot/1.0 (+https://github.com/opengov/explorer; public registry compliance bot)"
CRAWLER_DELAY_SECONDS=1.0
CRAWLER_MAX_RETRIES=5
CRAWLER_BACKOFF_FACTOR=1.5
CRAWLER_REQUEST_TIMEOUT=30.0
ENABLE_ROBOTS_TXT_CHECK=True
AUTO_SEED_FALLBACK=True

# Job Scheduler
SCHEDULE_INTERVAL_HOURS=6
ENABLE_SCHEDULER_ON_STARTUP=True

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000
