      "void": {
        "$value": "#030712",
        "$type": "color",
        "$description": "Pitch Carbon Black. Maximum contrast for full-bleed dark surfaces."
      },
      "cyan": {
        "$value": "#2563eb",
        "$type": "color",
        "$description": "Royal Bloomberg Cobalt Blue. High-visibility legal authority for active states, pills, icons, and status."
      },
      "mist": {
        "$value": "#edf2f7",
        "$type": "color",
        "$description": "Cool Alabaster Mist. Soft neutral fills and subtle card backgrounds."
      },
      "slate": {
        "$value": "#475467",
        "$type": "color",
        "$description": "Cool Zinc Slate. Secondary type, meta text, captions, hairlines."
      },
      "paper": {
        "$value": "#f8fafc",
        "$type": "color",
        "$description": "Cool Archival Alabaster Canvas. Clean modern page background and base substrate."
